generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Album {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverKey    String?
  isPublic    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  media       Media[]
}

model Media {
  id          String    @id @default(cuid())
  albumId     String?
  album       Album?    @relation(fields: [albumId], references: [id], onDelete: SetNull)
  key         String    @unique
  filename    String
  /// 展示标题（可选）；filename 始终保留原文件名
  title       String?
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  duration    Float?
  takenAt     DateTime?
  createdAt   DateTime  @default(now())
  tags        String[]  @default([])

  @@index([albumId])
  @@index([takenAt])
  @@index([createdAt])
}

model ShareLink {
  id        String   @id @default(cuid())
  token     String   @unique
  albumId   String?
  mediaIds  String[]
  password  String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model Visit {
  id         String   @id @default(cuid())
  ip         String
  path       String
  method     String   @default("GET")
  referer    String?
  userAgent  String?
  shareToken String?
  kind       String   @default("page")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
  @@index([path])
  @@index([shareToken])
  @@index([kind])
}

/// 键值配置（COS 等），敏感值可加密存储
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  /// 是否敏感（前端展示脱敏）
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
