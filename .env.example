# 数据库（Docker Compose 用 POSTGRES_PASSWORD；容器内 DATABASE_URL 会自动指向 db）
POSTGRES_PASSWORD=cos_password_change_me
DATABASE_URL="postgresql://cos:cos_password_change_me@localhost:5432/cos?schema=public"

# 存储厂商：cos | s3 | oss（也可在后台设置页切换，DB 优先）
# STORAGE_PROVIDER=cos

# 腾讯云 COS（默认）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-hongkong
# COS CDN（可留空；不要填中文网站域名。仅当已有英文 CDN 绑到本桶时才填）
COS_CDN_DOMAIN=

# STS：默认启用（用临时密钥签上传）；设为 0 可关闭并回退永久密钥预签名
COS_STS_ENABLED=1

# 列表缩略图宽度（数据万象 imageMogr2，需桶开通图片处理）
COS_THUMB_WIDTH=480

# 阿里云 OSS（STORAGE_PROVIDER=oss 时）
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=
# OSS_CNAME=0
# OSS_CDN_DOMAIN=
# OSS_THUMB_WIDTH=480
# OSS_WATERMARK_ENABLED=0
# OSS_WATERMARK_TEXT=

# NextAuth
NEXTAUTH_SECRET=请生成一串很长的随机字符串（可用 openssl rand -base64 32）
NEXTAUTH_URL=https://陈庆.我爱你
# 生产环境必须设置 NEXTAUTH_SECRET；session cookie 在 production 下自动 secure + httpOnly

# 首次启动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置至少12位强密码
# 登录限流：同一 IP 15 分钟内失败 5 次暂时拒绝（进程内 Map；多实例不共享）
