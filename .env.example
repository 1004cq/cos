# 数据库
DATABASE_URL="postgresql://user:password@localhost:5432/chenqing_gallery?schema=public"

# 腾讯云 COS（必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-guangzhou
# 如果使用了 CDN，填写 CDN 域名；否则可填 COS 默认域名或自定义域名
COS_CDN_DOMAIN=陈庆.我爱你

# NextAuth
NEXTAUTH_SECRET=请换成一串很长的随机字符串
NEXTAUTH_URL=https://陈庆.我爱你

# 首次启动时自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置强密码