# 数据库（Docker Compose 用 POSTGRES_PASSWORD；容器内 DATABASE_URL 会自动指向 db）
POSTGRES_PASSWORD=cos_password_change_me
DATABASE_URL="postgresql://cos:cos_password_change_me@localhost:5432/cos?schema=public"

# 腾讯云 COS（必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-guangzhou
# CDN 域名或自定义域名（推荐填写 陈庆.我爱你）
COS_CDN_DOMAIN=陈庆.我爱你

# STS：默认启用（用临时密钥签上传）；设为 0 可关闭并回退永久密钥预签名
COS_STS_ENABLED=1

# 列表缩略图宽度（数据万象 imageMogr2，需桶开通图片处理）
COS_THUMB_WIDTH=480

# NextAuth
NEXTAUTH_SECRET=请生成一串很长的随机字符串（可用 openssl rand -base64 32）
NEXTAUTH_URL=https://陈庆.我爱你

# 首次启动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置强密码
